# ==============================================================================
# CONFIGURAÇÃO DE BASE DE DADOS — PGU/TUB
# ==============================================================================
# Copia este ficheiro para ".env" e preenche com as credenciais reais.
#   cp .env.example .env
#
# Se deixares em branco, o sistema usará o modo local/demo.

# Host da Base de Dados (Ex: pgu-tub-db.mysql.database.azure.com)
DB_HOST=localhost

# Nome da Base de Dados
DB_NAME=tub

# Utilizador
DB_USER=tub_user

# Palavra-passe
DB_PASS=insira_aqui_a_password_da_bd_segura

# Pool de Conexões HikariCP — Número mínimo de conexões (default: 10)
DB_POOL_SIZE=10

# Pool de Conexões HikariCP — Número máximo de conexões (default: 20)
DB_MAX_POOL_SIZE=20

# ==============================================================================
# SEGURANÇA — AUTENTICAÇÃO ADMIN
# ==============================================================================
# Password do admin para login no backoffice
# NUNCA submeter este valor ao Git! Use Azure Key Vault em produção.
PGU_ADMIN_PASSWORD=insira_aqui_a_sua_password_do_admin_segura

# ==============================================================================
# SEGURANÇA — CORS (Cross-Origin Resource Sharing)
# ==============================================================================
# Origens permitidas para o frontend (separadas por vírgula)
# NUNCA usar "*" em produção! Especificar apenas os domínios necessários.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ==============================================================================
# NOTA: Após alterares este ficheiro, reinicia o servidor backend para aplicar.
# NUNCA submeter o ficheiro .env ao Git! (Já está no .gitignore)
# ==============================================================================
