# ==============================================================================
# CONFIGURAÇÃO DE BASE DE DADOS — PGU/TUB
# ==============================================================================
# Copia este ficheiro para ".env" e preenche com as credenciais reais.
#   cp .env.example .env
#
# Se deixares em branco, o sistema usará o modo local/demo.

# Host da Base de Dados (Ex: pgu-tub-db.mysql.database.azure.com)
DB_HOST=localhost

# Nome da Base de Dados
DB_NAME=tub

# Utilizador
DB_USER=tub_user

# Palavra-passe
DB_PASS=tub_pass

# ==============================================================================
# NOTA: Após alterares este ficheiro, reinicia o servidor backend para aplicar.
# NUNCA submeter o ficheiro .env ao Git! (Já está no .gitignore)
# ==============================================================================
